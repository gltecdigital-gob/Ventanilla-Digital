# Copia este archivo como .env y cambia los valores. Nunca subas .env al repositorio.
DEBUG=0
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
ALLOWED_HOSTS=tramites.ejemplo.gob.mx
CSRF_TRUSTED_ORIGINS=https://tramites.ejemplo.gob.mx
DATABASE_URL=postgres://plataforma:cambia-esta-clave@db:5432/plataforma
POSTGRES_PASSWORD=cambia-esta-clave

# Servicios externos (ver README). En producción no se permiten simuladores.
RENAPO_BACKEND=convenio
LLAVE_MX_BACKEND=atdt
SMS_BACKEND=pendiente
CONFIAR_PROXY=1
EMAIL_HOST=smtp.ejemplo.gob.mx
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=tramites@ejemplo.gob.mx
