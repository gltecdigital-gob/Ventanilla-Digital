# Copia este archivo como .env y cambia los valores. Nunca subas .env al repositorio.
DEBUG=0
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
# Llave para cifrar secretos en la base. Genera una con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLAVE_CIFRADO=
ALLOWED_HOSTS=tramites.ejemplo.gob.mx
CSRF_TRUSTED_ORIGINS=https://tramites.ejemplo.gob.mx
# Con docker-compose, DATABASE_URL se arma solo con APP_DB_PASSWORD.
# Fuera de Docker: el rol NO debe ser superusuario ni tener BYPASSRLS.
DATABASE_URL=postgres://plataforma_app:cambia-esta-clave@db:5432/plataforma
POSTGRES_PASSWORD=clave-del-superusuario-de-la-base
APP_DB_PASSWORD=cambia-esta-clave
SEGUNDO_FACTOR_OBLIGATORIO=1

# Servicios externos (ver README). En producción no se permiten simuladores.
RENAPO_BACKEND=convenio
LLAVE_MX_BACKEND=atdt
SMS_BACKEND=pendiente
CONFIAR_PROXY=1
EMAIL_HOST=smtp.ejemplo.gob.mx
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=tramites@ejemplo.gob.mx
